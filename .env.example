# Perseus Memory Agent — Environment Configuration
# Copy this file to .env and fill in your values

# Memory backend: "elastic" (cloud) or "engram" (self-hosted)
MEMORY_BACKEND=elastic

# Google Cloud (required for Agent Builder)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Elastic Cloud (required for elastic backend)
ELASTIC_CLOUD_ID=your-deployment-name:ZXVyb3BlLXdlc3QxLmdjcC5jbG91ZC5lcy5pbw==
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_MEMORY_INDEX=perseus-agent-memory
ELASTIC_MCP_ENDPOINT=https://your-deployment.es.us-central1.gcp.cloud.es.io:443

# Engram-rs (required for engram backend)
ENGRAM_BIN=engram
ENGRAM_DB_PATH=~/.hermes/mnemosyne/data/mnemosyne.db

# Agent behavior
MAX_CONTEXT_TOKENS=32000
RECALL_COUNT=10
AUTO_REFLECT=true
